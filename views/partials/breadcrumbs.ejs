<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <% items.forEach(function (item, i) { %>
    <li><% if (i < items.length - 1) { %><a href="<%= url(item.path) %>"><%= item.name %></a><% } else { %><span aria-current="page"><%= item.name %></span><% } %></li>
    <% }); %>
  </ol>
</nav>
