<%
/*
 * Developer hero: headline, lead and two CTAs on the left; four product cards on the right.
 * The card area is adapted from the 21st.dev "Split Hero With Image Cards" pattern (React +
 * Motion) to this site's EJS + CSS stack: a two-by-two grid whose second column sits lower,
 * so the four previews read as one staggered group without covering each other. The entrance
 * animation is CSS keyframes (home.css, .dhero) and honours prefers-reduced-motion.
 * Order is fixed: SaveFold, RunnerManager, PDFStruct, ResearchStruct. Images are real project
 * artwork from /public/img; every card links to a page on this site.
 */
var H = dict.hero;
var heroCards = [
  { key: 'savefold', href: '/projects/savefold', base: '/img/savefold/card', widths: [640, 1000, 1440], width: 1440, height: 810 },
  { key: 'runnermanager', href: '/runnermanager', base: '/img/runnermanager/dashboard', widths: [480, 728], width: 728, height: 422 },
  { key: 'pdfstruct', href: '/pdfstruct', base: '/img/pdfstruct/hero', widths: [640, 1100], width: 1672, height: 941 },
  { key: 'researchstruct', href: '/researchstruct', base: '/img/researchstruct/hero', widths: [640, 1100], width: 1672, height: 941 },
];
%>
<section class="dhero" aria-labelledby="hero-title">
  <div class="dhero__grid" aria-hidden="true"></div>
  <div class="container dhero__inner">
    <div class="dhero__copy">
      <p class="eyebrow dhero__eyebrow"><%= H.eyebrow %></p>
      <h1 class="dhero__title" id="hero-title"><%= H.headline %></h1>
      <p class="dhero__lead"><%= H.lead %></p>
      <div class="dhero__actions">
        <a class="button button--primary button--large" href="<%= url('/projects') %>"><%= H.ctaProjects %> <%- include('icon', { name: 'arrow' }) %></a>
        <a class="button button--secondary button--large" href="<%= url('/contact') %>"><%= H.ctaContact %></a>
      </div>
    </div>

    <ul class="dhero__cards" aria-label="<%= H.cardsLabel %>">
      <% heroCards.forEach(function (card, i) { var copy = H.cards[card.key]; %>
      <li class="dhero__item">
        <a class="dhero__card" href="<%= url(card.href) %>">
          <img class="dhero__card-img" src="<%= card.base %>-<%= card.widths[0] %>.webp" srcset="<%= card.widths.map(function (w) { return card.base + '-' + w + '.webp ' + w + 'w'; }).join(', ') %>" sizes="(min-width: 100rem) 23rem, (min-width: 62rem) 21rem, (min-width: 48rem) 22rem, 45vw" alt="<%= copy.alt %>" width="<%= card.width %>" height="<%= card.height %>"<%- i === 0 ? ' fetchpriority="high"' : '' %> decoding="async">
          <span class="dhero__card-label">
            <span class="dhero__card-text"><strong><%= copy.title %></strong><span><%= copy.caption %></span></span>
            <span class="dhero__card-cta"><span class="visually-hidden"><%= H.cardCta %></span><%- include('icon', { name: 'arrow' }) %></span>
          </span>
        </a>
      </li>
      <% }); %>
    </ul>
  </div>
</section>
