<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a class="brand brand--footer" href="<%= url('/') %>">
          <span class="brand__mark" aria-hidden="true"><%- include('icon', { name: 'mark' }) %></span>
          <span class="brand__text"><span class="brand__name"><%= site.name %></span></span>
        </a>
        <p class="site-footer__tagline"><%= t('footer.tagline') %></p>
        <p class="site-footer__meta"><%= t('footer.location') %></p>
        <ul class="site-footer__social" aria-label="<%= t('about.linksTitle') %>">
          <% if (site.github) { %>
          <li><a href="<%= site.github %>" rel="me noopener" target="_blank"><%- include('icon', { name: 'github' }) %><span>GitHub</span><span class="visually-hidden"> (<%= t('common.externalLink') %>)</span></a></li>
          <% } %>
          <% if (site.linkedin) { %>
          <li><a href="<%= site.linkedin %>" rel="me noopener" target="_blank"><%- include('icon', { name: 'linkedin' }) %><span>LinkedIn</span><span class="visually-hidden"> (<%= t('common.externalLink') %>)</span></a></li>
          <% } %>
          <li><a href="mailto:<%= site.email %>"><%- include('icon', { name: 'mail' }) %><span><%= site.email %></span></a></li>
        </ul>
      </div>

      <nav class="site-footer__nav" aria-label="<%= t('footer.navTitle') %>">
        <h2 class="site-footer__title"><%= t('footer.navTitle') %></h2>
        <ul>
          <% nav.forEach(function (item) { %>
          <li><a href="<%= item.href %>"><%= item.label %></a></li>
          <% }); %>
        </ul>
      </nav>

      <nav class="site-footer__nav" aria-label="<%= t('footer.projectsTitle') %>">
        <h2 class="site-footer__title"><%= t('footer.projectsTitle') %></h2>
        <ul>
          <% footerProjects.forEach(function (p) { %>
          <li><a href="<%= url('/projects/' + p.slug) %>"><%= p.title %></a></li>
          <% }); %>
        </ul>
      </nav>

      <nav class="site-footer__nav" aria-label="<%= t('nav.legalLabel') %>">
        <h2 class="site-footer__title"><%= t('footer.legalTitle') %></h2>
        <ul>
          <li><a href="<%= url('/imprint') %>"><%= t('nav.imprint') %></a></li>
          <li><a href="<%= url('/privacy') %>"><%= t('nav.privacy') %></a></li>
        </ul>
        <div class="site-footer__lang"><%- include('lang-switch') %></div>
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p>© <%= new Date().getFullYear() %> <%= site.name %>. <%= t('footer.rights') %></p>
      <p class="site-footer__built"><%= t('footer.builtWith') %></p>
    </div>
  </div>
</footer>

<script type="module" src="<%= assets.url('/js/main.js') %>"></script>
</body>
</html>
