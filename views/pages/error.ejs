<%- include('../partials/head') %>
<%- include('../partials/header') %>
<% var Er = dict.errors.server; %>

<main id="main" tabindex="-1">
  <div class="container error-page">
    <p class="error-page__code"><%= Er.code %> <%= status %></p>
    <h1 class="error-page__title"><%= Er.title %></h1>
    <p class="error-page__text"><%= Er.text %></p>
    <div class="error-page__actions">
      <a class="button button--primary" href="<%= url('/') %>"><%= Er.home %></a>
    </div>
    <% if (detail) { %><p class="error-page__detail">Development only: <%= detail %></p><% } %>
  </div>
</main>

<%- include('../partials/footer') %>
