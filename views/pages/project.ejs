<%- include('../partials/head') %>
<%- include('../partials/header') %>
<% var S = dict.projects.sections; %>

<main id="main" tabindex="-1">
  <header class="project-hero">
    <div class="container">
      <%- include('../partials/breadcrumbs', { items: [{ name: t('nav.home'), path: '/' }, { name: t('nav.projects'), path: '/projects' }, { name: project.title, path: '/projects/' + project.slug }] }) %>
      <div class="project-hero__grid">
        <div>
          <p class="eyebrow"><%= project.group === 'product' ? t('projects.groups.product.title') : t('projects.groups.client.title') %></p>
          <h1 class="project-hero__title"><%= project.title %></h1>
          <p class="project-hero__tagline"><%= project.tagline %></p>
          <div class="project-hero__actions">
            <% if (project.liveUrl) { %>
            <a class="button button--primary" href="<%= project.liveUrl %>" target="_blank" rel="noopener"><%= t('common.liveSite') %> <%- include('../partials/icon', { name: 'external' }) %><span class="visually-hidden"> (<%= t('common.externalLink') %>)</span></a>
            <% } %>
            <a class="button button--secondary" href="<%= url('/contact') %>"><%= t('nav.requestProject') %></a>
          </div>
        </div>
        <aside class="project-hero__facts" aria-label="<%= S.status %>">
          <dl class="fact-sheet">
            <div class="fact-sheet__row"><dt><%= t('projects.facts.status') %></dt><dd><span class="status status--<%= project.statusKey %>"><%= t('common.statusLabels.' + project.statusKey) %></span></dd></div>
            <div class="fact-sheet__row"><dt><%= t('projects.facts.type') %></dt><dd><%= project.kind === 'client' ? t('projects.kindClient') : t('projects.kindPersonal') %></dd></div>
            <% if (project.year) { %><div class="fact-sheet__row"><dt><%= t('projects.facts.year') %></dt><dd><%= project.year %></dd></div><% } %>
            <div class="fact-sheet__row"><dt><%= t('projects.facts.stack') %></dt><dd><%= project.tech.slice(0, 4).join(' · ') %></dd></div>
          </dl>
        </aside>
      </div>
    </div>
  </header>

  <% if (project.mediaAvailable.desktop || project.mediaAvailable.mobile) { %>
  <section class="project-media-section" aria-label="<%= S.media %>">
    <div class="container">
      <div class="device-pair">
        <%- include('../partials/project-media', { project: project, variant: 'detail' }) %>
        <div class="device-phone" aria-hidden="<%= project.mediaAvailable.mobile ? 'false' : 'true' %>">
          <div class="device-phone__screen">
            <% if (project.mediaAvailable.mobile) { %>
            <img src="/img/projects/<%= project.media.mobile %>" alt="<%= project.title %> – <%= t('projects.mediaMobile') %>" width="390" height="780" loading="lazy" decoding="async">
            <% } else { %>
            <span><%= t('projects.mediaMobile') %><br><%= t('projects.mediaPending') %></span>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </section>
  <% } %>

  <div class="container project-body">
    <div class="project-body__main">
      <section class="project-section" aria-labelledby="ps-summary">
        <h2 id="ps-summary"><%= S.summary %></h2>
        <p class="lead"><%= project.summary %></p>
      </section>

      <section class="project-section" aria-labelledby="ps-problem">
        <h2 id="ps-problem"><%= S.problem %></h2>
        <p><%= project.problem %></p>
      </section>

      <section class="project-section" aria-labelledby="ps-role">
        <h2 id="ps-role"><%= S.role %></h2>
        <p><%= project.role %></p>
      </section>

      <section class="project-section" aria-labelledby="ps-solution">
        <h2 id="ps-solution"><%= S.solution %></h2>
        <p><%= project.solution %></p>
      </section>

      <% if (preview && project.slug === 'savefold') { %>
      <section class="project-section" aria-labelledby="sf-title">
        <div class="sf-preview" data-sf-preview>
          <div class="sf-preview__head">
            <h3 id="sf-title"><%= preview.title %></h3>
            <p><%= preview.text %></p>
          </div>
          <ol class="sf-preview__steps">
            <% preview.steps.forEach(function (s) { %><li><%= s %></li><% }); %>
          </ol>
          <div class="sf-preview__app">
            <div class="sf-preview__side">
              <ul>
                <li><button class="sf-preview__cat" type="button" data-sf-cat="all" aria-pressed="true"><%= t('projects.filter.all') %></button></li>
                <% preview.sampleCategories.forEach(function (c) { %>
                <li><button class="sf-preview__cat" type="button" data-sf-cat="<%= c %>" aria-pressed="false"><%= c %></button></li>
                <% }); %>
              </ul>
            </div>
            <div class="sf-preview__main">
              <label class="sf-preview__search">
                <%- include('../partials/icon', { name: 'search' }) %>
                <span class="visually-hidden">Search</span>
                <input type="search" data-sf-search autocomplete="off" placeholder="…">
              </label>
              <ul class="sf-preview__items">
                <% preview.sampleItems.forEach(function (item) { %>
                <li class="sf-preview__item" data-sf-item data-sf-category="<%= item.category %>">
                  <%- include('../partials/icon', { name: 'link' }) %>
                  <span><span class="sf-preview__item-title"><%= item.title %></span><br><span class="sf-preview__item-source"><%= item.source %></span></span>
                  <span class="sf-preview__item-cat"><%= item.category %></span>
                </li>
                <% }); %>
              </ul>
              <p class="sf-preview__empty" data-sf-empty hidden>–</p>
            </div>
          </div>
        </div>
      </section>
      <% } %>

      <% if (preview && project.slug === 'authoritylab') { %>
      <section class="project-section" aria-labelledby="al-title">
        <div class="al-demo" data-al-demo>
          <div class="al-demo__head">
            <h3 id="al-title"><%= preview.title %></h3>
            <p><%= preview.text %></p>
          </div>
          <div class="al-demo__body">
            <div>
              <p class="al-demo__legend" id="al-choose"><%= preview.chooseLabel %></p>
              <ul class="al-demo__cases" aria-labelledby="al-choose">
                <% preview.cases.forEach(function (c, i) { %>
                <li><button class="al-demo__case" type="button" data-al-case data-al-decision="<%= c.decision %>" data-al-label="<%= preview.legend[c.decision] %>" data-al-reason="<%= c.reason %>" aria-pressed="<%= i === 0 ? 'true' : 'false' %>"><%= c.label %></button></li>
                <% }); %>
              </ul>
            </div>
            <div class="al-demo__result" data-al-result data-decision="<%= preview.cases[0].decision %>" aria-live="polite">
              <p class="al-demo__decision" data-al-decision><%= preview.cases[0].decision %> · <%= preview.legend[preview.cases[0].decision] %></p>
              <p class="al-demo__reason" data-al-reason><%= preview.cases[0].reason %></p>
            </div>
          </div>
          <ul class="al-demo__legend-list">
            <% Object.keys(preview.legend).forEach(function (k) { %><li data-k="<%= k %>"><%= k %> – <%= preview.legend[k] %></li><% }); %>
          </ul>
        </div>
      </section>
      <% } %>

      <section class="project-section" aria-labelledby="ps-tech">
        <h2 id="ps-tech"><%= S.technology %></h2>
        <ul class="tag-list">
          <% project.tech.forEach(function (tech) { %><li><%= tech %></li><% }); %>
        </ul>
      </section>

      <section class="project-section" aria-labelledby="ps-features">
        <h2 id="ps-features"><%= S.features %></h2>
        <ul>
          <% project.features.forEach(function (f) { %><li><%= f %></li><% }); %>
        </ul>
      </section>

      <section class="project-section" aria-labelledby="ps-security">
        <h2 id="ps-security"><%= S.security %></h2>
        <ul>
          <% project.security.forEach(function (f) { %><li><%= f %></li><% }); %>
        </ul>
      </section>

      <section class="project-section" aria-labelledby="ps-outcomes">
        <h2 id="ps-outcomes"><%= S.outcomes %></h2>
        <ul>
          <% project.outcomes.forEach(function (f) { %><li><%= f %></li><% }); %>
        </ul>
        <% if (project.outcomesNote) { %><p class="project-section__note"><%= project.outcomesNote %></p><% } %>
      </section>
    </div>

    <aside class="project-aside">
      <div class="project-aside__box">
        <h2 class="project-aside__title"><%= S.status %></h2>
        <p><span class="status status--<%= project.statusKey %>"><%= t('common.statusLabels.' + project.statusKey) %></span></p>
        <% if (project.liveUrl) { %>
        <p class="mt-3"><a class="link-arrow" href="<%= project.liveUrl %>" target="_blank" rel="noopener"><%= project.liveUrl.replace(/^https?:\/\//, '').replace(/\/$/, '') %> <%- include('../partials/icon', { name: 'external' }) %><span class="visually-hidden"> (<%= t('common.externalLink') %>)</span></a></p>
        <% } %>
      </div>

      <% if (relatedServices.length) { %>
      <div class="project-aside__box">
        <h2 class="project-aside__title"><%= t('nav.services') %></h2>
        <ul class="project-aside__links">
          <% relatedServices.forEach(function (s) { %>
          <li><a class="link-arrow" href="<%= url('/services') %>#<%= s.slug %>"><%= s.title %> <%- include('../partials/icon', { name: 'arrow' }) %></a></li>
          <% }); %>
        </ul>
      </div>
      <% } %>

      <div class="project-aside__box project-aside__cta">
        <h2><%= project.ctaTitle %></h2>
        <p><%= project.ctaText %></p>
        <a class="button" href="<%= url('/contact') %>"><%= t('nav.requestProject') %> <%- include('../partials/icon', { name: 'arrow' }) %></a>
      </div>
    </aside>
  </div>

  <div class="container">
    <nav class="project-next" aria-label="<%= t('common.nextProject') %>">
      <a class="link-arrow link-arrow--back" href="<%= url('/projects') %>"><%= t('common.backToProjects') %> <span class="icon-flip"><%- include('../partials/icon', { name: 'arrow' }) %></span></a>
      <div class="project-next__to">
        <p class="project-next__label"><%= t('common.nextProject') %></p>
        <p class="project-next__title"><a href="<%= url('/projects/' + nextProject.slug) %>"><%= nextProject.title %> →</a></p>
      </div>
    </nav>
  </div>
</main>

<%- include('../partials/footer') %>
