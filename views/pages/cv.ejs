<%- include('../partials/head') %>
<%- include('../partials/header') %>
<% var C = dict.cv; %>

<main id="main" tabindex="-1">
  <header class="page-header">
    <div class="container">
      <%- include('../partials/breadcrumbs', { items: [{ name: t('nav.home'), path: '/' }, { name: t('nav.cv'), path: '/cv' }] }) %>
      <p class="eyebrow"><%= C.eyebrow %></p>
      <h1 class="page-header__title"><%= C.title %></h1>
      <p class="page-header__intro"><%= C.intro %></p>
    </div>
  </header>

  <div class="container section">
    <div class="cv-grid">
      <div>
        <section class="cv-section" aria-labelledby="cv-profile">
          <h2 id="cv-profile"><%= C.sections.profile %></h2>
          <p class="lead"><%= C.profile %></p>
        </section>

        <section class="cv-section" aria-labelledby="cv-focus">
          <h2 id="cv-focus"><%= C.sections.focus %></h2>
          <ul class="cv-list">
            <% C.focus.forEach(function (f) { %><li><%- include('../partials/icon', { name: 'check' }) %><span><%= f %></span></li><% }); %>
          </ul>
        </section>

        <section class="cv-section" aria-labelledby="cv-projects">
          <h2 id="cv-projects"><%= C.sections.projects %></h2>
          <% projects.forEach(function (p) { %>
          <div class="cv-entry">
            <span class="cv-entry__title"><a href="<%= url('/projects/' + p.slug) %>"><%= p.title %></a> · <%= p.kind === 'client' ? t('projects.kindClient') : t('projects.kindPersonal') %></span>
            <span class="cv-entry__meta"><%= p.year %> · <%= t('common.statusLabels.' + p.statusKey) %> · <%= p.tech.slice(0, 4).join(', ') %></span>
            <span class="cv-entry__text"><%= p.role %></span>
          </div>
          <% }); %>
        </section>

        <section class="cv-section" aria-labelledby="cv-education">
          <h2 id="cv-education"><%= C.sections.education %></h2>
          <% C.education.forEach(function (e) { %>
          <div class="cv-entry">
            <span class="cv-entry__title"><%= e.title %></span>
            <span class="cv-entry__text"><%= e.text %></span>
          </div>
          <% }); %>
          <p class="cv-note"><%= C.note %></p>
        </section>

        <section class="cv-section" aria-labelledby="cv-languages">
          <h2 id="cv-languages"><%= C.sections.languages %></h2>
          <dl class="fact-sheet">
            <% site.languages.forEach(function (l) { %>
            <div class="fact-sheet__row"><dt><%= t('common.languageNames.' + l.code) %></dt><dd><%= t('common.languageLevels.' + l.level) %></dd></div>
            <% }); %>
          </dl>
        </section>

        <section class="cv-section" aria-labelledby="cv-skills">
          <h2 id="cv-skills"><%= C.sections.skills %></h2>
          <dl class="fact-sheet">
            <% skillGroups.forEach(function (g) { %>
            <div class="fact-sheet__row"><dt><%= g.title %></dt><dd><%= g.items.join(', ') %></dd></div>
            <% }); %>
          </dl>
        </section>
      </div>

      <aside class="sticky-aside">
        <div class="cv-download">
          <h2><%= C.downloadTitle %></h2>
          <% if (cvPath) { %>
          <a class="button button--primary" href="<%= cvPath %>" download><%- include('../partials/icon', { name: 'download' }) %> <%= t('common.downloadCv') %></a>
          <% } else { %>
          <p><%= C.downloadPending %></p>
          <a class="button button--primary" href="<%= url('/contact') %>"><%= C.requestCv %> <%- include('../partials/icon', { name: 'arrow' }) %></a>
          <% } %>
          <ul class="profile-links mt-2">
            <li><a href="<%= site.github %>" rel="me noopener" target="_blank"><%- include('../partials/icon', { name: 'github' }) %> GitHub<span class="visually-hidden"> (<%= t('common.externalLink') %>)</span></a></li>
            <li><a href="mailto:<%= site.email %>"><%- include('../partials/icon', { name: 'mail' }) %> <%= site.email %></a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
