<%- include('../partials/head') %>
<%- include('../partials/header') %>
<% var L = dict.legal.privacy; %>

<main id="main" tabindex="-1">
  <header class="page-header">
    <div class="container">
      <%- include('../partials/breadcrumbs', { items: [{ name: t('nav.home'), path: '/' }, { name: t('nav.privacy'), path: '/privacy' }] }) %>
      <h1 class="page-header__title"><%= L.title %></h1>
      <p class="legal-updated"><%= L.updated %></p>
    </div>
  </header>

  <div class="container section">
    <div class="prose">
      <% L.sections.forEach(function (s) { %>
      <section class="legal-section">
        <h2><%= s.title %></h2>
        <% s.paragraphs.forEach(function (p) { %>
        <% var text = p.replace('{email}', site.email); %>
        <% if (text.indexOf(site.email) !== -1) { %>
        <p><%= text.split(site.email)[0] %><a href="mailto:<%= site.email %>"><%= site.email %></a><%= text.split(site.email)[1] || '' %></p>
        <% } else { %>
        <p><%= text %></p>
        <% } %>
        <% }); %>
      </section>
      <% }); %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
