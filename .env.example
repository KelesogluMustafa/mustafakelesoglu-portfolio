# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Public origin used for canonical URLs, hreflang and the sitemap.
SITE_URL=https://mustafakelesoglu.de

# Number of reverse proxies in front of the app (Hostinger: 1).
TRUST_PROXY=1

# Contact form
CONTACT_TO=info@mustafakelesoglu.de
# "log" = validate without delivering. Switch to "smtp" only after the mailbox exists.
CONTACT_TRANSPORT=log
CONTACT_SMTP_HOST=smtp.hostinger.com
CONTACT_SMTP_PORT=465
CONTACT_SMTP_SECURE=true
CONTACT_SMTP_USER=info@mustafakelesoglu.de
CONTACT_SMTP_PASS=
CONTACT_SMTP_FROM=info@mustafakelesoglu.de
CONTACT_RATE_WINDOW_MS=900000
CONTACT_RATE_MAX=5

# Profiles (LinkedIn stays empty until the owner supplies the URL)
SOCIAL_GITHUB=https://github.com/KelesogluMustafa
SOCIAL_LINKEDIN=
