# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Public origin used for canonical URLs, hreflang and the sitemap.
SITE_URL=https://mustafakelesoglu.de

# Number of reverse proxies in front of the app (Hostinger: 1).
TRUST_PROXY=1

# Contact form
CONTACT_TO=info@mustafakelesoglu.de
# "log" = validate and log without personal data, tell the visitor delivery is not active yet.
# Real delivery (smtp/api) is intentionally not implemented until the owner approves a provider.
CONTACT_TRANSPORT=log
CONTACT_RATE_WINDOW_MS=900000
CONTACT_RATE_MAX=5

# Profiles (LinkedIn stays empty until the owner supplies the URL)
SOCIAL_GITHUB=https://github.com/KelesogluMustafa
SOCIAL_LINKEDIN=

# Path to the approved CV PDF under /public (empty = "on request" state)
CV_PDF_PATH=
